# ─────────────────────────────────────────────
#  NFT Marketplace — Hardhat Environment
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Blockchain ──────────────────────────────────────────────────────────────
# Alchemy Sepolia RPC endpoint (create at https://alchemy.com)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployer wallet private key — export from MetaMask (Account Details → Export)
# Use a dedicated deployer wallet, never your main wallet.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Verification ────────────────────────────────────────────────────────────
# Etherscan API key for contract verification (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Gas Reporting ───────────────────────────────────────────────────────────
# Set to "true" to generate gas-report.txt when running tests
REPORT_GAS=false

# CoinMarketCap API key for USD gas cost estimates (optional)
# COINMARKETCAP_API_KEY=YOUR_CMC_KEY

# ── Frontend Sync ───────────────────────────────────────────────────────────
# Set to "true" to auto-update frontend ABI and address files after deploy
UPDATE_FRONT_END=false
